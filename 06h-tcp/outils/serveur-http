#!/bin/sh
# Le serveur HTTP de la page de test (6h) : QEMU le lance pour chaque
# connexion du système invité vers 10.0.2.100:80 (guestfwd de son réseau
# « utilisateur », voir QEMU_RESEAU dans le Makefile), son entrée et sa
# sortie reliées à la connexion. Ni port ouvert sur l'hôte, ni Internet.
#
# libslirp le lance sans shell (g_shell_parse_argv, puis g_spawn) : d'où la
# ligne #! ; et sa sortie d'erreur part, elle aussi, dans la connexion : on
# la fait taire avant tout (un « write error » d'awk, quand le client ferme
# tôt, arriverait chez lui au milieu de la page).
exec 2>/dev/null

# La requête : sa première ligne, puis ses en-têtes jusqu'à la ligne vide
# (chacune finit par CR LF : read garde le CR).
IFS= read -r requete || exit 0
while IFS= read -r ligne; do
    case $ligne in
        "" | "$(printf '\r')") break ;;
    esac
done

# GET /page : 4 Mio de texte, en lignes de 16 octets qui disent chacune leur
# propre position dans la page (en hexadécimal, sur 15 chiffres, puis une
# fin de ligne). Le client (linux/telecharger.c) recalcule chaque octet : un
# segment TCP perdu, doublé ou mis dans le désordre (1460 octets, pas un
# multiple de 16) casse une ligne à sa place, et il dit laquelle. Autre
# chose : 404, sans corps. Connection: close : la fin de la page est la fin
# de la connexion, comme HTTP/1.0.
case $requete in
    "GET /page "*)
        printf 'HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 4194304\r\nConnection: close\r\n\r\n'
        awk 'BEGIN { for (i = 0; i < 4194304; i += 16) printf "%015x\n", i }'
        ;;
    *)
        printf 'HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\nConnection: close\r\n\r\n'
        ;;
esac
