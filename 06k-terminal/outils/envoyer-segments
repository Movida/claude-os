#!/bin/bash
# Joue une machine du réseau de slirp que slirp n'a pas (10.0.2.77), pour
# test-carte (make tests-qemu) : envoie à la machine, par la socket UDP de
# QEMU (`-netdev dgram`, reliée à la carte par un concentrateur), des
# segments TCP auxquels elle doit répondre comme Linux répond sans socket
# (`ip_send_unicast_reply`) : le TOS du segment sans ses bits ECN, le TTL
# du système (64), l'écho de ses options. Le Makefile lit les réponses dans
# l'enregistrement de la carte (outils/segments-tcp.awk). Puis de la
# multidiffusion et des requêtes d'IGMP, et deux erreurs ICMP pour la
# socket UDP de `reseau carte` (linux/reseau.c), qui y lit leurs extensions
# (RFC 4884).
#   outils/envoyer-segments PORT    (PORT : le local.port de -netdev dgram)
# slirp doit d'abord être débranché (set_link) : il prendrait les réponses
# pour une connexion à faire suivre, et défairait la fille par un RST.
# bash, pour /dev/udp et le \x de son printf. Chaque trame doit partir dans
# un seul datagramme, que QEMU donne tel quel au concentrateur : le printf
# de bash écrit par morceaux (il vide sa sortie à chaque octet 0x0a, comme
# à une fin de ligne), dd les réunit et écrit la trame d'un coup. Une pause
# entre deux, pour qu'elles arrivent dans l'ordre où la machine les traite.
set -e
cd "$(dirname "$0")"
exec 3>/dev/udp/127.0.0.1/"$1"
trame() {
    printf "$(awk "$@" -f trame.awk)" | dd bs=2048 count=1 iflag=fullblock status=none >&3
    sleep 0.2
}
# Où est 10.0.2.77 : la machine l'apprend de sa requête ARP.
trame -v genre=arp
# Un SYN vers le port 23, fermé, de TOS 0x13 (le DSCP 0x10, et les bits ECN
# à CE) : le RST de la machine a le TOS 0x10 (`tcp_v4_send_reset`) et le
# TTL 64.
trame -v genre=tcp -v tos=19 -v ttl=50 -v source=40000 -v destination=23 -v seq=1000 -v drapeaux=2
# Un SYN vers l'écoute du port 4001 : une fille, et son SYN-ACK, au TOS
# (0x20) et au TTL (33) de l'écoute.
trame -v genre=tcp -v tos=19 -v ttl=50 -v source=40001 -v destination=4001 -v seq=1000 -v drapeaux=2
# Un ACK qui n'acquitte pas le SYN-ACK (le numéro de la fille est inconnu
# ici : 12 345 n'a qu'une chance sur 2^32 d'être le bon), avec une route
# notée d'une place (7, 7, 4, puis la place et une fin de liste) : le RST
# de l'écoute (`tcp_rcv_state_process`), TOS 0x10, TTL 64, et l'écho de
# l'option (un en-tête de 28 octets), pas ce qu'a demandé l'écoute.
trame -v genre=tcp -v tos=19 -v ttl=50 -v source=40001 -v destination=4001 -v seq=1001 -v ack=12345 -v drapeaux=16 \
      -v options=0707040000000000
# Un octet de données loin hors de la fenêtre de la fille, sans ACK : son
# ACK (`tcp_v4_reqsk_send_ack`), TOS 0x10 et TTL 64 aussi ; des données,
# pour que la limite des ACK hors fenêtre ne le retienne pas.
trame -v genre=tcp -v tos=19 -v ttl=50 -v source=40001 -v destination=4001 -v seq=501001 -v drapeaux=8 -v donnees=1
# La multidiffusion (`reseau carte` a adhéré à 239.1.2.3, port 4003) : un
# datagramme de 6 octets pour le groupe, dans une trame pour son adresse
# Ethernet (01:00:5e:01:02:03), qu'il reçoit ; un pour 239.1.2.4, qu'il n'a
# pas : rien.
trame -v genre=udp -v ttl=64 -v vers=239.1.2.3 -v mac=01005e010203 -v source=4444 -v destination=4003 -v donnees=6
trame -v genre=udp -v ttl=64 -v vers=239.1.2.4 -v mac=01005e010204 -v source=4444 -v destination=4003 -v donnees=6
# Deux diffusions (255.255.255.255) de somme fausse, vers un port que
# personne n'écoute : de 38 octets, vérifiée aussitôt (CHECKSUM_BREAK : 76
# octets), InCsumErrors et InErrors ; de 208, IgnoredMulti seulement
# (`__udp4_lib_mcast_deliver` ne la vérifie pas). `reseau carte` lit les
# compteurs dans /proc/net/snmp.
trame -v genre=udp -v ttl=64 -v vers=255.255.255.255 -v mac=ffffffffffff -v source=4444 -v destination=4009 -v donnees=30 \
      -v faussee=1
trame -v genre=udp -v ttl=64 -v vers=255.255.255.255 -v mac=ffffffffffff -v source=4444 -v destination=4009 -v donnees=200 \
      -v faussee=1
# IGMP : une requête v3 générale (vers 224.0.0.1, TTL 1, l'alerte aux
# routeurs ; délai 0,1 s, QRV 2, QQIC 125 s) : le rapport de l'état courant,
# IS_EX {} pour 239.1.2.3 ; puis une requête v2 (8 octets, délai 0,1 s) :
# la machine parle v2 (260 s), et son rapport v2 va au groupe. Le Makefile
# les lit dans l'enregistrement de la carte (outils/igmp.awk), `reseau
# carte` dans /proc/net/igmp.
trame -v genre=igmp -v ttl=1 -v options=94040000 -v vers=224.0.0.1 -v mac=01005e000001 -v type=17 -v code=1 -v v3=1 -v qrv=2 \
      -v qqic=125
trame -v genre=igmp -v ttl=1 -v options=94040000 -v vers=224.0.0.1 -v mac=01005e000001 -v type=17 -v code=1
# Deux redirections (5, 1) qui citent un en-tête de 4 mots : Linux les
# passe au protocole cité, qui lit ses « ports » dans l'en-tête lui-même et
# n'y trouve aucune socket ; UDP le compte (Icmp InErrors), ping non.
# `reseau carte` lit le compteur.
trame -v genre=icmp -v ttl=64 -v type=5 -v code=1 -v ihl=4 -v source=4002 -v destination=9 -v donnees=8
trame -v genre=icmp -v ttl=64 -v type=5 -v code=1 -v ihl=4 -v cite=1 -v source=4002 -v destination=9 -v donnees=8
# « Port injoignable » pour un datagramme de 100 octets que la machine
# aurait envoyé du port 4002 au port 9 : la copie (128 octets, que dit
# l'octet 5 : 32 mots), puis des extensions (un en-tête de version 2, un
# objet de 8 octets), de somme juste, puis fausse. Les deux derniers
# envois : `reseau carte` dit sa fin quand il les a lues.
trame -v genre=icmp -v ttl=64 -v type=3 -v code=3 -v longueur=32 -v source=4002 -v destination=9 -v donnees=100 \
      -v extension=2000xxxx00080101deadbeef
trame -v genre=icmp -v ttl=64 -v type=3 -v code=3 -v longueur=32 -v source=4002 -v destination=9 -v donnees=100 \
      -v extension=2000xxxx00080101deadbeef -v faussee=1
