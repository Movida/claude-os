{
  "name": "OS x86 + Wasm",
  "build": { "dockerfile": "Dockerfile" },
  // Plafonne la mémoire du conteneur à 8 Go, sans swap (--memory seul en
  // laisserait autant) : un programme qui s'emballe est tué dans le conteneur
  // au lieu d'épuiser la mémoire de WSL, qui se fige avec Docker et VS Code.
  "runArgs": ["--memory=8g", "--memory-swap=8g"],
  "features": {
    // Node.js, puis Claude Code lui-même dans le conteneur.
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  // Garde la connexion Claude Code d'une reconstruction du conteneur à l'autre.
  "mounts": [
    "source=claude-code-config,target=/home/vscode/.claude,type=volume"
  ],
  // Claude Code range aussi .claude.json (la confiance dans chaque dossier,
  // l'accord pour Remote Control) dans ce volume, et non dans ~ où une
  // reconstruction l'effaçait : Remote Control ne pouvait plus démarrer sans
  // qu'on relance `claude` à la main. Le dossier est celui que Claude Code
  // prend déjà par défaut ; seul .claude.json change de place (le script de
  // Remote Control l'y reprend la première fois).
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },
  // Démarre Claude Code en mode Remote Control (voir le script).
  "postStartCommand": "bash .devcontainer/remote-control.sh ${containerWorkspaceFolder}",
  "customizations": {
    "vscode": {
      "extensions": [
        "13xforever.language-x86-64-assembly",
        "anthropic.claude-code"
      ]
    }
  },
  "remoteUser": "vscode"
}
