{
  "name": "OS x86 + Wasm",
  "build": { "dockerfile": "Dockerfile" },
  // Plafonne la mémoire du conteneur à 8 Go, sans swap (--memory seul en
  // laisserait autant) : un programme qui s'emballe est tué dans le conteneur
  // au lieu d'épuiser la mémoire de WSL, qui se fige avec Docker et VS Code.
  //
  // --stop-timeout : à l'arrêt, le serveur Remote Control a jusqu'à 30 s pour ses
  // sessions, puis prévient claude.ai ; les 10 s par défaut le couperaient.
  //
  // --restart=on-failure : le conteneur repart si son processus principal meurt.
  // Après un arrêt brutal (Windows éteint sans arreter-conteneur.sh), Docker le
  // prend aussi pour un échec et le relance à son propre démarrage, souvent avant
  // que les dossiers de WSL soient montés. Ce démarrage-là échoue, ou laisse le
  // superviseur attendre sans le dépôt ; le service claude-os-conteneur de WSL le
  // refait ensuite (voir demarrer-conteneur.sh). Après un arrêt propre, Docker ne le
  // relance pas.
  "runArgs": [
    "--memory=8g",
    "--memory-swap=8g",
    "--stop-timeout=45",
    "--restart=on-failure"
  ],
  // Le processus principal du conteneur est le CMD de l'image, le superviseur de
  // Remote Control (voir remote-control.sh), et non la boucle d'attente que met
  // VS Code par défaut. Il tourne donc sans fenêtre VS Code et reçoit SIGTERM à
  // l'arrêt, sous l'utilisateur vscode, celui des sessions.
  "overrideCommand": false,
  "containerUser": "vscode",
  // docker-init en PID 1 : il transmet SIGTERM au superviseur et ramasse les
  // processus orphelins (QEMU, sessions) à sa place.
  "init": true,
  // Fermer la fenêtre de VS Code n'arrête plus le conteneur, ni donc les sessions.
  "shutdownAction": "none",
  "features": {
    // Node.js, puis Claude Code lui-même dans le conteneur.
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  // Garde la connexion Claude Code d'une reconstruction du conteneur à l'autre.
  "mounts": [
    "source=claude-code-config,target=/home/vscode/.claude,type=volume"
  ],
  // Claude Code range aussi .claude.json (la confiance dans chaque dossier,
  // l'accord pour Remote Control) dans ce volume, et non dans ~ où une
  // reconstruction l'effaçait : Remote Control ne pouvait plus démarrer sans
  // qu'on relance `claude` à la main. Le dossier est celui que Claude Code
  // prend déjà par défaut ; seul .claude.json change de place (le script de
  // Remote Control l'y reprend la première fois).
  //
  // CLAUDE_ENV_FILE : les commandes des sessions passent avant elles quand la
  // mémoire manque (voir sacrifiable.sh).
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "CLAUDE_ENV_FILE": "/usr/local/share/remote-control/sacrifiable.sh"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "13xforever.language-x86-64-assembly",
        "anthropic.claude-code"
      ]
    }
  },
  "remoteUser": "vscode"
}
